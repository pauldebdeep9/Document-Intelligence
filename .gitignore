__pycache__/
*.py[cod]
.venv/
.env
config/local.yaml
runs/
data/synthetic/*
!data/synthetic/.gitkeep
# Generated by `isc ingest`/`isc index`, rebuilt wholesale on every run --
# never committed. docstore.sqlite in particular: SQLite is a database, not a
# fixture, and vector_store.pkl is loaded via pickle.load(), which executes
# arbitrary code on load -- a tracked pickle in a public repo is a standing
# InfoSec flag regardless of provenance. data/blobs is isc ingest's copy of
# data/synthetic (already ignored above) keyed by content hash -- same
# category, derived and reproducible now that gen_corpus.py's PDF timestamps
# are pinned, with no reason to ship it.
data/docstore.sqlite
data/vector_store.pkl
data/blobs/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.conda/
