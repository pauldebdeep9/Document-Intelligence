# ---- Provider selection --------------------------------------------------
# openai | azure   (azure_openai_client.py is a stub until the Azure account exists)
ISC_LLM__PROVIDER=openai

# ---- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-...
ISC_LLM__CHAT_MODEL=gpt-4o-mini
ISC_LLM__EMBED_MODEL=text-embedding-3-small

# ---- Azure OpenAI (later) ------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# ISC_LLM__CHAT_DEPLOYMENT=gpt-4o-mini
# ISC_LLM__EMBED_DEPLOYMENT=text-embedding-3-small
# Auth via DefaultAzureCredential; no key in env.

# ---- Runtime -------------------------------------------------------------
ISC_ENV=local
ISC_CACHE__ENABLED=true
